# Security (set a strong key for your environment)
API_KEY=your-api-key-here

# Voice pipeline & TTS
OBFUSCATION_STRENGTH=mild
STT_MODEL=small.en
TTS_PROVIDER=local
# Local offline TTS voice name (optional, defaults to system default voice e.g. "Microsoft David Desktop" or "Microsoft Zira Desktop" on Windows)
# LOCAL_TTS_VOICE=Microsoft David Desktop
# Remote TTS voice (only used if TTS_PROVIDER=remote for non-sensitive public prompts)
EDGE_TTS_VOICE=en-US-GuyNeural
# Strict privacy boundary: never send private database/connector results to remote TTS
ALLOW_REMOTE_TTS_FOR_SENSITIVE_DATA=false

# LLM Orchestrator
OLLAMA_MODEL=llama3.2:latest
MAX_RESULTS=10
MAX_RETRIES=2

# Audio limits
# MAX_AUDIO_SIZE_MB=25
# MAX_AUDIO_DURATION_SECONDS=120.0

# Timeouts (seconds)
LLM_TIMEOUT_SECONDS=120.0
TTS_TIMEOUT_SECONDS=45.0
# STT_TIMEOUT_SECONDS=60.0
# OBFUSCATION_TIMEOUT_SECONDS=30.0

# CORS & Logging
# ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# LOG_TRANSCRIPTS=false

# Storage backend: "memory" (default, single-process) or "redis" (multi-worker)
STORAGE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
# Audio and clarification TTLs (seconds)
AUDIO_TTL_SECONDS=3600
CLARIFICATION_TTL_SECONDS=120
